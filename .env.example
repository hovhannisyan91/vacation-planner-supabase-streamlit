# Select the database-backed repository. Use DATA_BACKEND=csv for the local fallback.
DATA_BACKEND=supabase
DB_SCHEMA=vacation

# Supabase Postgres connection values.
# Keep this file as a template; put the real password in an untracked .env file.
DB_USER=postgres
DB_PASSWORD=replace-with-your-supabase-database-password
DB_HOST=db.lrrozhtefdvklyhfehut.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_SSLMODE=require

# The original lowercase names are accepted too: user, password, host, port, dbname.
# DATABASE_URL may be used instead of the individual DB_* values.

